generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// CORE SAAS & AUTHENTICATION
// -------------------------------------------------------------

model Restaurant {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  address         String?
  phone           String?
  currency        String            @default("INR")
  taxRate         Float             @default(5.0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  users           User[]
  tables          Table[]
  categories      Category[]
  menuItems       MenuItem[]
  orders          Order[]
  inventory       InventoryItem[]
  happyHourRules  HappyHourRule[]
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String       @default("demo123")
  role          String       @default("CUSTOMER") // CUSTOMER, WAITER, KITCHEN, ADMIN, SUPERADMIN
  phone         String?
  loyaltyPoints Int          @default(150)
  restaurantId  String?
  restaurant    Restaurant?  @relation(fields: [restaurantId], references: [id])
  createdAt     DateTime     @default(now())
}

// -------------------------------------------------------------
// TABLES & FLOOR PLAN
// -------------------------------------------------------------

model Table {
  id           String        @id @default(uuid())
  number       String        // e.g. "T-01", "T-02"
  capacity     Int           @default(4)
  section      String        @default("Main Floor") // Main Floor, Patio, Balcony, Bar
  status       String        @default("FREE") // FREE, OCCUPIED, RESERVED, CLEANING
  qrCodeUrl    String?
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  
  orders       Order[]
  reservations Reservation[]
  waiterCalls  WaiterCall[]
}

// -------------------------------------------------------------
// DIGITAL MENU & CATALOG
// -------------------------------------------------------------

model Category {
  id           String       @id @default(uuid())
  name         String
  slug         String
  sortOrder    Int          @default(0)
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]
}

model MenuItem {
  id              String       @id @default(uuid())
  name            String
  description     String
  price           Float
  imageUrl        String
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])
  isAvailable     Boolean      @default(true) // 86'd toggle
  isVeg           Boolean      @default(false)
  isGlutenFree    Boolean      @default(false)
  spiceLevel      Int          @default(0) // 0 to 4
  prepTimeMinutes Int          @default(15)
  allergens       String       @default("") // comma separated: "Nuts, Dairy"
  restaurantId    String
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id])
  
  orderItems      OrderItem[]
  reviews         Review[]
}

// -------------------------------------------------------------
// ORDERS & TICKETS (KDS & CUSTOMER)
// -------------------------------------------------------------

model Order {
  id               String       @id @default(uuid())
  orderNumber      String       @unique // e.g. "ORD-1082"
  type             String       @default("DINE_IN") // DINE_IN, PICKUP, DELIVERY
  status           String       @default("PLACED") // PLACED, CONFIRMED, PREPARING, READY, SERVED, CANCELLED
  paymentStatus    String       @default("PENDING") // PENDING, PAID
  tableId          String?
  table            Table?       @relation(fields: [tableId], references: [id])
  totalAmount      Float
  discountAmount   Float        @default(0)
  taxAmount        Float        @default(0)
  guestNotes       String?
  customerName     String       @default("Guest Customer")
  customerPhone    String?
  estimatedMinutes Int          @default(20)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  restaurantId     String
  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id])
  
  items            OrderItem[]
  payments         Payment[]
  reviews          Review[]
}

model OrderItem {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem  @relation(fields: [menuItemId], references: [id])
  quantity        Int       @default(1)
  unitPrice       Float
  subtotal        Float
  selectedOptions String?   // JSON string of options/extras
  notes           String?
}

// -------------------------------------------------------------
// RESERVATIONS & BOOKINGS
// -------------------------------------------------------------

model Reservation {
  id            String      @id @default(uuid())
  customerName  String
  customerEmail String
  customerPhone String
  partySize     Int         @default(2)
  date          String      // e.g. "2026-09-25"
  timeSlot      String      // e.g. "19:30"
  status        String      @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED
  notes         String?
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id])
  createdAt     DateTime    @default(now())
}

// -------------------------------------------------------------
// PAYMENTS & REVIEWS
// -------------------------------------------------------------

model Payment {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  amount         Float
  method         String    @default("CARD") // CARD, CASH, UPI, STRIPE
  status         String    @default("SUCCESS") // SUCCESS, PENDING, FAILED
  transactionRef String?
  createdAt      DateTime  @default(now())
}

model Review {
  id            String    @id @default(uuid())
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id])
  menuItemId    String?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id])
  customerName  String    @default("Foodie Explorer")
  rating        Int       @default(5)
  foodRating    Int       @default(5)
  serviceRating Int       @default(5)
  comment       String
  createdAt     DateTime  @default(now())
}

// -------------------------------------------------------------
// STANDOUT FEATURES: CALL WAITER, RESTOCKING & HAPPY HOUR
// -------------------------------------------------------------

model WaiterCall {
  id        String    @id @default(uuid())
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id])
  reason    String    @default("Water") // Water, Bill, Cutlery, Assistance
  status    String    @default("ACTIVE") // ACTIVE, RESOLVED
  createdAt DateTime  @default(now())
}

model InventoryItem {
  id                   String     @id @default(uuid())
  name                 String     // e.g. "Wagyu Beef Patties", "Truffle Oil"
  currentStock         Float      // e.g. 14.5
  minThreshold         Float      // e.g. 10.0
  unit                 String     // "kg", "units", "liters"
  costPerUnit          Float
  reorderPredictedDays Int        @default(2) // moving average forecast
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id])
}

model HappyHourRule {
  id              String     @id @default(uuid())
  title           String     // "Sunset Twilight 20% Off"
  discountPercent Float      @default(20)
  startHour       Int        @default(16) // 4 PM
  endHour         Int        @default(19) // 7 PM
  daysOfWeek      String     @default("Mon,Tue,Wed,Thu,Fri")
  isActive        Boolean    @default(true)
  targetCategory  String     @default("All") // or category name
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
}
